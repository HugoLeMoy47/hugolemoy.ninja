---
import Layout from './Layout.astro';
import { CUADERNO } from '../lib/cuaderno';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** 'indice' marca «Cuaderno» como página actual en la navegación. */
  pagina: 'indice' | 'pieza';
}

const { title, description, ogType = 'website', pagina } = Astro.props;

const enlace =
  'underline underline-offset-4 decoration-1 text-sky-700 hover:text-sky-900 dark:text-gits-cyan dark:hover:text-white';
---

<Layout title={title} description={description} ogType={ogType} scanlines={false} esquemaPersona={false}>
  <slot name="head" slot="head" />

  <div class="relative z-10 min-h-screen flex flex-col bg-[#fafafa] dark:bg-cyber-void text-slate-900 dark:text-cyber-textBright">
    <header class="border-b border-slate-200 dark:border-cyber-border bg-[#fafafa] dark:bg-cyber-void px-4 py-3">
      <div class="max-w-3xl mx-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-mono text-sm">
        <a
          href="/"
          class="font-bold tracking-wider text-red-700 dark:text-ninja-crimson flex items-center gap-1.5 py-1"
        >
          <span class="font-serif" aria-hidden="true">忍</span>
          <span>hugolemoy.ninja</span>
        </a>

        <nav aria-label="Principal">
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
            <li><a href="/" class={`${enlace} inline-block py-1`}>Inicio</a></li>
            <li>
              <a
                href={CUADERNO.ruta}
                class={`${enlace} inline-block py-1`}
                aria-current={pagina === 'indice' ? 'page' : undefined}
              >
                Cuaderno
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido" class="flex-1 w-full max-w-3xl mx-auto px-4 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-cyber-border px-4 py-5 font-mono text-xs text-slate-600 dark:text-slate-400">
      <div class="max-w-3xl mx-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <span>Hugo Legorreta Moysén · hugolemoy.ninja</span>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
          <li><a href={CUADERNO.ruta} class={enlace}>Cuaderno de construcción</a></li>
          <li><a href="https://freejolitos.consulting" class={enlace}>Freejolitos Consultores</a></li>
          <li><a href="https://www.linkedin.com/in/hugolegorretamoysen/" class={enlace}>LinkedIn de Hugo</a></li>
        </ul>
      </div>
    </footer>
  </div>
</Layout>
