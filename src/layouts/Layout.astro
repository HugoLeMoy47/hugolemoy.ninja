---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Capa de líneas CRT. Se apaga en páginas de lectura larga para no restar legibilidad. */
  scanlines?: boolean;
  /** Ficha Schema.org de la persona (portada). Las páginas del Cuaderno publican su propio esquema. */
  esquemaPersona?: boolean;
}

const DESCRIPCION_PERSONA = "Tarjeta de presentación multidimensional de Hugo Legorreta Moysén: Product Owner, Consultor Tecnológico en Freejolitos, activista en La Comuna 420 (#Capital420 / Senado), creador de weedtown.social, creador de contenido digital y desarrollador de videojuegos.";

const {
  title = "Hugo Legorreta Moysén (HLM) — Cyber-Hub & Portafolio Multidimensional",
  description = DESCRIPCION_PERSONA,
  ogType = 'website',
  scanlines = true,
  esquemaPersona = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://hugolemoy.ninja");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Hugo Legorreta Moysén",
  "alternateName": ["Hugo LeMoy", "HLM", "HugoLeMoy47"],
  "url": "https://hugolemoy.ninja",
  "jobTitle": "Product Owner · Consultor Tecnológico · Creador de Contenido Digital & Desarrollador de Videojuegos",
  "worksFor": {
    "@type": "Organization",
    "name": "Freejolitos Consultores",
    "url": "https://freejolitos.consulting"
  },
  "description": DESCRIPCION_PERSONA,
  "sameAs": [
    "https://github.com/HugoLeMoy47",
    "https://linkedin.com/in/hugolegorretamoysen",
    "https://facebook.com/HugoLeMoy",
    "https://x.com/HugoLeMoy",
    "https://instagram.com/hugolemoy",
    "https://weedtown.social",
    "https://freejolitos.consulting",
    "https://globalgamejam.org/users/hugolemoy",
    "https://www.youtube.com/playlist?list=PLfSXXT0u4t5RG5iac7Fe9WkqCtlcFJt-7"
  ],
  "knowsAbout": [
    "Product Management",
    "Agile Scrum",
    "Serious Games",
    "Cannabis Public Policy",
    "Freejolitos",
    "weedtown.social",
    "La Comuna 420",
    "Data Governance",
    "TypeScript",
    "Python",
    "Godot Engine"
  ]
};
---

<!doctype html>
<html lang="es-MX" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Initialization Script (Avoid Flash) -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var savedTheme = 'dark';
        try { savedTheme = localStorage.getItem('hlm_theme') || 'dark'; } catch (e) {}
        root.classList.toggle('dark', savedTheme !== 'light');
        // El arranque cinematográfico se ve una vez por sesión y nunca con movimiento reducido.
        var visto = false;
        try { visto = sessionStorage.getItem('hlm_boot_visto') === '1'; } catch (e) {}
        var reducido = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (visto || reducido) root.classList.add('hlm-booted');
      })();
    </script>

    <!-- Canonical & Sitemap -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06090e" />
    <meta name="color-scheme" content="dark light" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="hugolemoy.ninja" />
    <meta property="og:image" content="https://hugolemoy.ninja/og-image.jpg" />
    <meta property="og:image:secure_url" content="https://hugolemoy.ninja/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hugo Legorreta Moysén — Product Owner, Consultor Tecnológico & Desarrollador de Videojuegos" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hugolemoy.ninja/og-image.jpg" />
    <meta name="twitter:creator" content="@HugoLeMoy" />
    <meta name="twitter:site" content="@HugoLeMoy" />

    <!-- LLMs / AI Agents Discovery Link -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Agent Manifest" />

    <!-- Google Fonts: Space Grotesk & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700;800&family=Space+Grotesk:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data Schema -->
    {esquemaPersona && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}

    <!-- Sin JavaScript la animación de arranque nunca termina: se oculta para que el contenido se pueda leer -->
    <noscript><style>.hlm-boot-overlay { display: none !important; }</style></noscript>

    <slot name="head" />
  </head>
  <body class="bg-cyber-void text-cyber-textBright min-h-screen selection:bg-ninja-crimson selection:text-white relative">
    
    <a href="#contenido" class="enlace-saltar">Saltar al contenido</a>

    <!-- CRT Scanline Overlay -->
    {scanlines && <div class="fixed inset-0 scanlines-overlay z-30 pointer-events-none" aria-hidden="true"></div>}

    <slot />

  </body>
</html>
