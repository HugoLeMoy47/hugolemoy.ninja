---
import CuadernoLayout from '../../layouts/CuadernoLayout.astro';
import { CUADERNO, obtenerPiezas, rutaDePieza, fechaLarga, fechaISO } from '../../lib/cuaderno';

const piezas = await obtenerPiezas();
---

<CuadernoLayout
  title={`${CUADERNO.nombre} · Hugo Legorreta Moysén`}
  description={CUADERNO.resumen}
  pagina="indice"
>
  <header class="mb-10">
    <p class="font-mono text-xs uppercase tracking-wider text-red-700 dark:text-ninja-crimson mb-3">
      Bitácora Viva · en primera persona
    </p>
    <h1 class="font-display font-black tracking-tight text-3xl sm:text-4xl text-slate-900 dark:text-white">
      {CUADERNO.nombre}
    </h1>
    <div class="prosa mt-5">
      <p>
        Construyo Bitácora Viva: un expediente digital único para albergues y organizaciones que
        atienden a personas en movilidad. Hoy es una prueba de concepto y trabaja solo con datos de
        prueba.
      </p>
      <p>
        Aquí cuento los retos técnicos y los dilemas éticos de construirlo. Qué decidí, por qué, y
        qué sigue sin resolverse. Para saber qué resuelve el producto y para quién, está la
        <a href="https://freejolitos.consulting/bitacora-viva">página de Bitácora Viva en Freejolitos</a>.
        El registro fechado de avances vive en el
        <a href="https://freejolitos.consulting/laboratorio">Laboratorio de Freejolitos</a>.
      </p>
    </div>
  </header>

  <section aria-labelledby="piezas-titulo">
    <h2
      id="piezas-titulo"
      class="font-mono text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 border-b border-slate-200 dark:border-cyber-border pb-3 mb-6"
    >
      Piezas
    </h2>

    {
      piezas.length === 0 ? (
        <p class="text-slate-700 dark:text-slate-300">Todavía no hay piezas publicadas.</p>
      ) : (
        <ol class="space-y-5" reversed>
          {piezas.map((pieza) => (
            <li>
              <article class="rounded-xl bg-white dark:bg-cyber-card border border-slate-200 dark:border-cyber-border p-5 sm:p-6">
                <p class="font-mono text-xs text-slate-600 dark:text-slate-400 mb-2">
                  <time datetime={fechaISO(pieza.data.fecha)}>{fechaLarga(pieza.data.fecha)}</time>
                </p>
                <h3 class="font-display font-bold text-xl sm:text-2xl leading-snug">
                  <a
                    href={rutaDePieza(pieza)}
                    class="text-slate-900 dark:text-white underline underline-offset-4 decoration-1 decoration-slate-400 hover:decoration-red-700 dark:decoration-slate-500 dark:hover:decoration-ninja-crimson"
                  >
                    {pieza.data.titulo}
                  </a>
                </h3>
                <p class="mt-3 text-slate-700 dark:text-slate-300 leading-relaxed">
                  {pieza.data.resumen}
                </p>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</CuadernoLayout>
