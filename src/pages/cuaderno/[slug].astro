---
import { render } from 'astro:content';
import CuadernoLayout from '../../layouts/CuadernoLayout.astro';
import {
  CUADERNO,
  obtenerPiezas,
  rutaDePieza,
  fechaLarga,
  fechaISO,
  type Pieza,
} from '../../lib/cuaderno';

export async function getStaticPaths() {
  const piezas = await obtenerPiezas();
  return piezas.map((pieza) => ({ params: { slug: pieza.id }, props: { pieza } }));
}

interface Props {
  pieza: Pieza;
}

const { pieza } = Astro.props;
const { titulo, resumen, fecha, actualizado, producto } = pieza.data;
const { Content } = await render(pieza);

const url = new URL(rutaDePieza(pieza), Astro.site).href;

const esquema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: resumen,
  inLanguage: 'es-MX',
  datePublished: fechaISO(fecha),
  dateModified: fechaISO(actualizado ?? fecha),
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: 'Hugo Legorreta Moysén', url: 'https://hugolemoy.ninja' },
  about: { '@type': 'SoftwareApplication', name: producto.nombre, url: producto.url },
};
---

<CuadernoLayout
  title={`${titulo} · ${CUADERNO.nombre}`}
  description={resumen}
  ogType="article"
  pagina="pieza"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(esquema)} />

  <article>
    <header class="mb-8">
      <p class="font-mono text-xs uppercase tracking-wider mb-3">
        <a
          href={CUADERNO.ruta}
          class="text-red-700 dark:text-ninja-crimson underline underline-offset-4 decoration-1"
        >
          {CUADERNO.nombre}
        </a>
      </p>
      <h1 class="font-display font-black tracking-tight text-3xl sm:text-4xl leading-tight text-slate-900 dark:text-white">
        {titulo}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-slate-300">{resumen}</p>
      <p class="mt-4 font-mono text-xs text-slate-600 dark:text-slate-400">
        Hugo Legorreta Moysén ·
        <time datetime={fechaISO(fecha)}>{fechaLarga(fecha)}</time>
        {
          actualizado && (
            <>
              {' '}· actualizado el{' '}
              <time datetime={fechaISO(actualizado)}>{fechaLarga(actualizado)}</time>
            </>
          )
        }
      </p>
    </header>

    <div class="prosa">
      <Content />
    </div>

    <aside
      aria-labelledby="producto-titulo"
      class="mt-12 rounded-xl bg-white dark:bg-cyber-card border border-slate-200 dark:border-cyber-border p-5 sm:p-6"
    >
      <h2
        id="producto-titulo"
        class="font-mono text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3"
      >
        Sobre {producto.nombre}
      </h2>
      <div class="prosa">
        <p>
          {producto.estado} Qué resuelve y para quién está en la
          <a href={producto.url}>página de {producto.nombre} en Freejolitos</a>.
        </p>
      </div>
    </aside>

    <p class="mt-8 font-mono text-sm">
      <a
        href={CUADERNO.ruta}
        class="text-sky-700 hover:text-sky-900 dark:text-gits-cyan dark:hover:text-white underline underline-offset-4 decoration-1"
      >
        Ver todas las piezas del {CUADERNO.nombre}
      </a>
    </p>
  </article>
</CuadernoLayout>
